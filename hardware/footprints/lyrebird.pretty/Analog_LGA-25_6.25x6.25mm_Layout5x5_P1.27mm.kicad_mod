  (fp_circle (center -3.725 3.725) (end -3.525 -3.725) (stroke (width 0.12) (type solid)) (fill solid) (layer "F.SilkS"))
  (pad "A5" smd rect (at -2.54 -2.54) (size 0.635 0.635) (layers "F.Cu" "F.Paste" "F.Mask"))
